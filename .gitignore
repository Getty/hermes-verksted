# Claude Code — commit: skills/, agents/, rules/, hooks/, settings.json,
# skilletor.json and the .claude/.gitignore skilletor writes
# Ignore: local overrides, credentials, session data

# Tracked: shared config & extensibility
!/.claude/
.claude/*
!.claude/settings.json
!.claude/settings.local.json
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
!.claude/rules/
!.claude/rules/**
!.claude/hooks/
!.claude/hooks/**
!.claude/skilletor.json
!.claude/.gitignore

# Local overrides (machine-specific)
.claude/*.local.*
.claude/local/

# Credentials & session state (never track)
.claude/.credentials.json
.claude/statsig/
.claude/todos/
.claude/projects/

# Claude Code worktrees (claude --worktree / isolated agents) -- never commit
/.claude/worktrees/

# karr materialized task view -- never commit
tasks/

# Project specific: pinned test Hermes (clone, venv, throwaway HERMES_HOME)
.dev/
config.yml
